# Copy to .env (git-ignored) and fill in. Both apps read it:
#   cd apps/mobile && flutter run --dart-define-from-file=../../.env
#   cd apps/admin  && flutter run -d chrome --dart-define-from-file=../../.env
#
# Supabase: Project Settings → API → Project URL / anon (publishable) key.
# Leave empty to use the local stack (supabase start, http://127.0.0.1:54421).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional: Google Sign-In (the Google button only shows when these are set)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
